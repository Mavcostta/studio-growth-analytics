{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "fluid": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 240,
      "excludeFiles": "{credentials/**,.env*,.qa/**,.git/**,**/*.pem,**/*.key,**/*service-account*.json,**/*service_account*.json}"
    }
  }
}
