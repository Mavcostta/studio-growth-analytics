{
  "name": "studio-growth-analytics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json",
    "server:dev": "tsc -p tsconfig.server.json && node .server-build/index.js --dev",
    "test:instagram": "tsc -p tsconfig.test.json && node --test .test-build/tests/instagram.test.js .test-build/tests/instagram-posts.test.js",
    "test:ga4": "tsc -p tsconfig.test.json && node --test .test-build/tests/ga4.test.js tests/ga4-render.test.mjs",
    "test:vercel": "tsc -p tsconfig.test.json && node --test .test-build/tests/vercel.test.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/analytics.test.js .test-build/tests/instagram-frontend.test.js",
    "preview": "vite preview --host 127.0.0.1",
    "snapshots:collect": "tsc -p tsconfig.server.json && node .server-build/collect-snapshots.js",
    "test:phase1": "tsc -p tsconfig.test.json && node --test .test-build/tests/phase1.test.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
